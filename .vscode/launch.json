{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Nodemon Backend Debugger",
      "runtimeExecutable": "nodemon",
      "runtimeArgs": [
        "--inspect",
        "server.js"
      ],
      "cwd": "${workspaceFolder}/backend",
      "restart": true,
      "protocol": "inspector",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
